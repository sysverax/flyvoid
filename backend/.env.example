# =============================================================================
# FlyVoid backend - environment variables
# Copy to .env.local (npm run dev), .env.dev, .env.test or .env.prod and fill in.
# Every key is read in src/config/config.ts; values shown are safe defaults
# or placeholders. Never commit real secrets.
# =============================================================================


# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_PORT=3000
APP_NAME=flyvoid-backend
APP_API_PREFIX=api

# Comma-separated list of origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173


# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=your_database_name
DB_MODE=development
DB_SIMULATE=true
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_SSL=false
# Queries slower than this are logged as warnings
DB_SLOW_QUERY_THRESHOLD_MS=200


# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
APP_LOGGING=false
# debug | info | warn | error
LOG_LEVEL=info


# -----------------------------------------------------------------------------
# Swagger / API docs
# -----------------------------------------------------------------------------
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
SWAGGER_TITLE=FlyVoid API
SWAGGER_DESCRIPTION=Development API documentation for the FlyVoid platform
SWAGGER_VERSION=1.0


# -----------------------------------------------------------------------------
# JWT
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=access-secret
JWT_REFRESH_SECRET=refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d


# -----------------------------------------------------------------------------
# Auth - forgot password (OTP)
# -----------------------------------------------------------------------------
FORGOT_PASSWORD_OTP_STATIC=444444
FORGOT_PASSWORD_OTP_EXPIRY_MINUTES=2
FORGOT_PASSWORD_OTP_MAX_ATTEMPTS=5
FORGOT_PASSWORD_OTP_SEND_LIMIT=3
FORGOT_PASSWORD_OTP_SEND_WINDOW_MINUTES=10
FORGOT_PASSWORD_RESET_TOKEN_EXPIRES_IN=1h
INITIAL_PASSWORD_RESET_TOKEN_EXPIRES_IN=15m


# -----------------------------------------------------------------------------
# Auth - two-factor authentication
# -----------------------------------------------------------------------------
TWO_FACTOR_ISSUER=Flyvoid
TWO_FACTOR_CHALLENGE_TOKEN_EXPIRES_IN=5m
# 64 hex characters (32 bytes); generate a new one per environment
TWO_FACTOR_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
TWO_FACTOR_OTP_WINDOW=1


# -----------------------------------------------------------------------------
# Airline admin invitations
# -----------------------------------------------------------------------------
AIRLINE_ADMIN_INVITE_EXPIRES_IN=48h
AIRLINE_ADMIN_ONBOARDING_BASE_URL=http://localhost:3000/airline/onboard


# -----------------------------------------------------------------------------
# Email (AWS SES)
# -----------------------------------------------------------------------------
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-ses-access-key
AWS_SECRET_ACCESS_KEY=your-ses-secret-access-key
AWS_SES_FROM_EMAIL=noreply@example.com


# -----------------------------------------------------------------------------
# AI (OpenAI-compatible chat completions API)
# -----------------------------------------------------------------------------
AI_API_KEY=your-ai-api-key
AI_MODEL=llama-3.3-70b-versatile
AI_API_URL=https://api.groq.com/openai/v1/chat/completions
AI_TEMPERATURE=0.2


# -----------------------------------------------------------------------------
# Hotel supplier
# -----------------------------------------------------------------------------
# Active supplier: ratehawk | hotelbeds
HOTEL_PROVIDER=ratehawk
# Applies to whichever supplier is active
HOTEL_USE_SANDBOX=true

# Hotelbeds credentials
HOTELBEDS_API_KEY=
HOTELBEDS_SECRET=

# RateHawk credentials
RATEHAWK_API_KEY=
RATEHAWK_USER_ID=

# FlyVoid inbox sent to hotel suppliers on every booking; receives booking
# confirmations and B2B-priced documents. Required in production.
BOOKING_CONFIRMATION_EMAIL=


# -----------------------------------------------------------------------------
# Passenger bookings
# -----------------------------------------------------------------------------
# Maximum passengers (adults + children) on one PNR
MAX_PASSENGERS_PER_PNR=9


# -----------------------------------------------------------------------------
# Hotel booking / allocation
# -----------------------------------------------------------------------------
HOTEL_SUPPLY_BUFFER_RATIO=1.5
HOTEL_BOOKING_CONCURRENCY=3
HOTEL_BOOKING_MAX_ATTEMPTS=5
# 5 minutes
HOTEL_ALLOCATION_RUN_LEASE_MS=300000
# 1 hour
HOTEL_BOOKING_PLAN_TTL_MS=3600000
# 90 seconds
HOTEL_ORDER_INFO_DELAY_MS=90000
# 24 hours
HOTEL_WEBHOOK_MAX_AGE_MS=86400000
# 1 hour
HOTEL_BOOKING_ATTEMPT_STALE_MS=3600000


# -----------------------------------------------------------------------------
# Hotel content (static hotel data) refresh
# -----------------------------------------------------------------------------
# 7 days
HOTEL_CONTENT_STALE_AFTER_MS=604800000
# 24 hours
HOTEL_CONTENT_REFRESH_INTERVAL_MS=86400000
# Most hotels refreshed in one scheduled run
HOTEL_CONTENT_REFRESH_LIMIT=5000


# -----------------------------------------------------------------------------
# Hotel search
# -----------------------------------------------------------------------------
HOTEL_SEARCH_RADIUS=10
HOTEL_SEARCH_RADIUS_UNIT=km
HOTEL_SEARCH_MAX_RADIUS=50
# Minimum star rating
HOTEL_SEARCH_MIN_RATE=3


# -----------------------------------------------------------------------------
# Pricing
# -----------------------------------------------------------------------------
PLATFORM_FEE_PERCENTAGE=10
