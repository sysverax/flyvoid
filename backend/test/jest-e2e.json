{
    "moduleFileExtensions": [
        "js",
        "json",
        "ts"
    ],
    "rootDir": ".",
    "testEnvironment": "node",
    "testRegex": ".*\\.e2e-spec\\.ts$",
    "transform": {
        "^.+\\.(t|j)s$": [
            "ts-jest",
            {
                "tsconfig": {
                    "module": "commonjs",
                    "target": "es2021",
                    "esModuleInterop": true,
                    "types": [
                        "node",
                        "jest"
                    ],
                    "emitDecoratorMetadata": true,
                    "experimentalDecorators": true
                }
            }
        ]
    },
    "testTimeout": 30000,
    "moduleNameMapper": {
        "^src/(.*)$": "<rootDir>/../src/$1"
    }
}