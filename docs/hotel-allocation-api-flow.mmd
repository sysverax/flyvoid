%% FlyVoid — POST /cancelled-flights/:id/hotel-allocations (202, runs in background)
%%          GET  /cancelled-flights/:id/hotel-allocations (poll progress + results)
%% Allocation = live supplier booking per PNR. Fully deterministic (no AI).
%% Vendor calls are cross-referenced into their own files:
%%   - hotel-allocation-vendor-hotelbeds.mmd / hotel-allocation-vendor-ratehawk.mmd
%% HotelProvider is a single DI-selected adapter (env HOTEL_PROVIDER = hotelbeds | ratehawk).
%% Planner (pools, ledger, ranking): backend/src/cancelled-flights/hotel-allocation.planner.ts

flowchart TD
    A(["Client"]) -->|"POST /:id/hotel-allocations"| B["Controller.hotelAllocations"]
    B --> B1{"JwtAuthGuard + RBAC<br/>AIRLINE / CANCELLED_FLIGHTS / EDIT"}
    B1 -->|"denied"| B2["401 / 403"]
    B1 -->|"allowed"| C["Service.startHotelAllocation"]

    C --> C1{"Flight of this airline?<br/>status in PASSENGERS_BOOKING_CONFIRMED,<br/>ALLOCATED, stale HOTEL_ALLOCATION_IN_PROGRESS?<br/>cancellation date + departure airport?<br/>any bookings?"}
    C1 -->|"no"| E1["400 / 404"]
    C1 -->|"yes"| L1[("DB tx: claimFlightAllocationRun<br/>lock flight row; refuse a run within its lease;<br/>status = HOTEL_ALLOCATION_IN_PROGRESS, new run id")]
    L1 -->|"run already active"| E2["409 Conflict<br/>(UI polls the running run)"]
    L1 --> R1(["202 Accepted + current status<br/>UI polls GET every 3s until running = false"])
    L1 -.->|"background"| L2[("heartbeat every lease/5 (fenced by run id)<br/>IN_PROGRESS rows older than 60 min → MANUAL_CHECK")]
    L2 --> P1["Pending PNRs = no row, DRAFT, FAILED, CANCELLED<br/>(CONFIRMED / MANUAL_CHECK / IN_PROGRESS skipped → idempotent)<br/>sorted: class → special needs → children → PNR"]

    P1 --> P2["Per PNR: resolveRoomSplitPlan<br/>invalid data → row FAILED"]
    P2 --> V1[["Hotel vendor: availability search<br/>(deduplicated occupancies)"]]
    V1 -->|"error"| E3["run error saved (hotelAllocationError)<br/>nothing booked"]
    V1 --> P3["Choose split per PNR (unchanged rules)<br/>demand per room shape"]
    P3 --> P4["Supply pool per shape:<br/>rates by exact-fit, stars DESC, price ASC<br/>until allotment ≥ ceil(demand × 1.5)<br/>(no hotel cap; less supply → keep all, continue)"]
    P4 --> P5["Run-wide allotment ledger<br/>(synchronous claim / release / commit)"]

    P5 --> S1["Class stages in order:<br/>FIRST → BUSINESS → PREMIUM_ECONOMY → ECONOMY<br/>each stage settles before the next starts"]
    S1 --> S2["Within a stage: PNRs in parallel<br/>(HOTEL_BOOKING_CONCURRENCY, default 3)"]

    S2 --> F1["Per PNR (sequential fallback):<br/>rankCandidates — one hotel for all rooms;<br/>pool before overflow, stars DESC, total price ASC"]
    F1 -->|"no candidate left"| F9[("row FAILED + reason")]
    F1 --> F2["ledger.tryClaim(rooms)"]
    F2 --> F3[["Hotel vendor: checkRate every room"]]
    F3 -->|"fails"| F7
    F3 --> F4[("short DB tx: claimHotelReservation<br/>row IN_PROGRESS + booking_attempt<br/>(attemptId, hotel, rateKeys, requestedAt)")]
    F4 -->|"row booked / being booked elsewhere"| F8["skip (blocked) — release claim"]
    F4 --> F5[["Hotel vendor: bookHotel per room"]]
    F5 -->|"all rooms confirmed"| F6[("row CONFIRMED<br/>real supplier reference(s), final hotel + price<br/>ledger.commit")]
    F5 -->|"definite failure, nothing booked"| F7[("row FAILED (this attempt)<br/>ledger.release, exclude rate for PNR")]
    F7 --> F1
    F5 -->|"timeout / unknown outcome /<br/>some rooms booked"| F10[("row MANUAL_CHECK<br/>supplier refs + unknown reference<br/>ledger keeps rooms; NO other hotel tried")]

    F6 --> Z1
    F9 --> Z1
    F10 --> Z1
    F8 --> Z1
    E3 --> Z1
    Z1[("DB tx: completeFlightAllocationRun (only if run id still matches)<br/>totals from CONFIRMED rows only;<br/>status = ALLOCATED if ≥1 confirmed,<br/>else PASSENGERS_BOOKING_CONFIRMED; save run error")]
    Z1 --> Z2["GET returns running = false<br/>confirmed / failed / manual-check counts<br/>+ per-PNR status, hotel, supplier ref, reason, lastRunError"]

    style V1 fill:transparent,stroke:#2b7ac9,stroke-width:1.5px,stroke-dasharray: 4 3
    style F3 fill:transparent,stroke:#2b7ac9,stroke-width:1.5px,stroke-dasharray: 4 3
    style F5 fill:transparent,stroke:#2b7ac9,stroke-width:1.5px,stroke-dasharray: 4 3
