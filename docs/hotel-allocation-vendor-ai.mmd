%% FlyVoid — AI vendor (src/common/ai/ai.service.ts)
%% Called from hotel-allocation-api-flow.mmd once room-option shortlists
%% and passenger groups are built and batched by token budget.
%% A batch that fails does not abort the request — its groups fall through
%% to the deterministic rescue pass in the main flow instead.

flowchart TD
    A(["Called with: batches of<br/>{roomOptions (aliased rate keys), groups}<br/>concurrency limit = 3 (AI_BATCH_CONCURRENCY)"]) --> B["mapWithConcurrency over batches"]

    subgraph PERBATCH[" Per batch: allocateHotelGroups "]
        B --> C1{"config.ai.apiKey<br/>configured?"}
        C1 -->|"no"| C2["warn log,<br/>throw ServiceUnavailableException<br/>(batch → unresolved, not fatal)"]
        C1 -->|"yes"| C3["Build responseSchema (expected JSON shape:<br/>assignments[], unresolved[])"]
        C3 --> C4["userPrompt = responseSchema +<br/>JSON.stringify({roomOptions, groups})"]
        C4 --> C5["requestJsonFromAi(systemPrompt, userPrompt)"]

        subgraph HTTP[" requestJsonFromAi "]
            C5 --> D1["info log: Calling AI API {model}"]
            D1 --> D2["POST config.ai.apiUrl<br/>Authorization: Bearer apiKey<br/>body: {model, messages[system,user],<br/>temperature, reasoning_effort: low,<br/>max_completion_tokens: 4000}<br/>(no response_format — reasoning models reject it)"]
            D2 --> D3{"HTTP 429?"}
            D3 -->|"yes"| D4{"attempt ≤ 2?"}
            D4 -->|"yes"| D5["parseRetryDelayMs:<br/>Retry-After header, or<br/>'try again in Xs' in error body<br/>(capped at 30s + 250ms buffer)"]
            D5 --> D6["warn log, sleep, retry"] --> D2
            D4 -->|"no"| D7["throw: AI API returned 429"]
            D3 -->|"no"| D8{"response.ok?"}
            D8 -->|"no"| D9["throw: AI API returned<br/>status X: errorText"]
            D8 -->|"yes"| D10["Extract message.content<br/>(or message.reasoning as fallback)"]
            D10 --> D11{"Content empty?"}
            D11 -->|"yes"| D12["throw: empty AI response"]
            D11 -->|"no"| D13["parseJsonContent:<br/>strip json code fences,<br/>else extract outermost braces"]
            D13 --> RETH["Return parsed JSON"]
        end

        RETH --> C6["Coerce result.assignments /<br/>result.unresolved to arrays<br/>(default to [] if not arrays)"]
        C6 --> RETP["Return {assignments, unresolved}<br/>for this batch"]

        C2 --> C7["catch: error log,<br/>rethrow ServiceUnavailableException<br/>AI API allocation failed: message"]
        D7 --> C7
        D9 --> C7
        D12 --> C7
        C7 --> RETF["Batch marked failed —<br/>hotel-allocation-api-flow.mmd treats its<br/>groups as unresolved, not a hard abort"]
    end

    RETP --> E1["Merge all batch results:<br/>assignments (rateKey aliases like r0, r1)<br/>+ unresolved (passengerGroupId, reason)"]
    RETF --> E1
    E1 --> E2(["Return to hotel-allocation-api-flow.mmd:<br/>hard-rule verifier translates aliases<br/>back to real rate keys"])

    style HTTP fill:transparent,stroke:#7a2bc9,stroke-width:1.5px,stroke-dasharray: 4 3
